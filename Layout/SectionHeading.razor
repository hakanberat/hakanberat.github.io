@inherits LocalizedComponent
<div class="section-top">
    <div>
        @if (KickerKey is not null) { <p class="section-kicker">@T(KickerKey)</p> }
        <h2 id="@Id">@T(TitleKey)</h2>
    </div>
    @if (Href is not null) { <a class="text-link" href="@Href">@T(LinkKey!)</a> }
</div>
@code {
    [Parameter, EditorRequired] public string TitleKey { get; set; } = "";
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? KickerKey { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? LinkKey { get; set; }
}
