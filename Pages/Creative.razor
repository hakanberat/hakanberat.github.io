@page "/creative"
@inject HakanBeratDemircan.Services.LanguageService Language
@implements IDisposable
<PageTitle>@Language.Translate("Creative") | Hakan Berat Demircan</PageTitle>
<section class="page-intro"><p class="section-kicker">@Language.Translate("CreativeKicker")</p><h1>@Language.Translate("Creative")</h1><p class="hero-description">@Language.Translate("CreativePortfolioIntro")</p></section>
<div class="creative-grid"><article class="creative-card"><a href="https://www.behance.net/gallery/213693669/EMITT-Exhibition-Brochure" target="_blank" rel="noopener noreferrer"><img src="assets/behance-213693669.jpg" alt="@Language.Translate("BrochureTitle")" width="808" height="632" loading="lazy"/><div class="creative-copy"><p class="project-kind">@Language.Translate("BrochureKind")</p><h2>@Language.Translate("BrochureTitle")</h2><p>@Language.Translate("BrochureCopy")</p><span class="card-action">@Language.Translate("ViewOnBehance")</span></div></a></article><article class="creative-card"><a href="https://www.behance.net/gallery/213877653/Instagram-Vlogs" target="_blank" rel="noopener noreferrer"><img src="assets/behance-213877653.jpg" alt="@Language.Translate("VlogsTitle")" width="808" height="632" loading="lazy"/><div class="creative-copy"><p class="project-kind">@Language.Translate("VideoKind")</p><h2>@Language.Translate("VlogsTitle")</h2><p>@Language.Translate("VlogsCopy")</p><span class="card-action">@Language.Translate("ViewOnBehance")</span></div></a></article><article class="creative-card"><a href="https://www.behance.net/gallery/213822699/Instagram-Reels" target="_blank" rel="noopener noreferrer"><img src="assets/behance-213822699.jpg" alt="@Language.Translate("ReelsTitle")" width="808" height="632" loading="lazy"/><div class="creative-copy"><p class="project-kind">@Language.Translate("VideoKind")</p><h2>@Language.Translate("ReelsTitle")</h2><p>@Language.Translate("ReelsCopy")</p><span class="card-action">@Language.Translate("ViewOnBehance")</span></div></a></article><article class="creative-card"><a href="https://www.behance.net/gallery/213693475/Social-Media-Promotions" target="_blank" rel="noopener noreferrer"><img src="assets/behance-213693475.jpg" alt="@Language.Translate("SocialDesignTitle")" width="808" height="632" loading="lazy"/><div class="creative-copy"><p class="project-kind">@Language.Translate("SocialDesignKind")</p><h2>@Language.Translate("SocialDesignTitle")</h2><p>@Language.Translate("SocialDesignCopy")</p><span class="card-action">@Language.Translate("ViewOnBehance")</span></div></a></article><article class="creative-card"><a href="https://www.behance.net/gallery/213780033/AI-generated-images" target="_blank" rel="noopener noreferrer"><img src="assets/behance-213780033.jpg" alt="@Language.Translate("VisualTitle")" width="808" height="632" loading="lazy"/><div class="creative-copy"><p class="project-kind">@Language.Translate("VisualKind")</p><h2>@Language.Translate("VisualTitle")</h2><p>@Language.Translate("VisualCopy")</p><span class="card-action">@Language.Translate("ViewOnBehance")</span></div></a></article></div>
<section class="portfolio-section"><div class="section-top"><div><p class="section-kicker">DIVE HUB</p><h2>@Language.Translate("WatchExplore")</h2></div></div><div class="channel-grid"><a class="channel-card" href="https://www.youtube.com/@@divehubcyprus" target="_blank" rel="noopener noreferrer"><span class="channel-name">YouTube</span><h3>@Language.Translate("DiveHubVideo")</h3><p>@Language.Translate("DiveHubVideoText")</p><span class="card-action">@Language.Translate("VisitChannel")</span></a><a class="channel-card" href="https://www.instagram.com/divehub/" target="_blank" rel="noopener noreferrer"><span class="channel-name">Instagram</span><h3>@Language.Translate("DiveHubInstagram")</h3><p>@Language.Translate("DiveHubInstagramText")</p><span class="card-action">@Language.Translate("VisitChannel")</span></a><a class="channel-card" href="http://dive-hub.com/en/" target="_blank" rel="noopener noreferrer"><span class="channel-name">Dive Hub</span><h3>@Language.Translate("DiveHubSite")</h3><p>@Language.Translate("DiveHubSiteText")</p><span class="card-action">@Language.Translate("VisitChannel")</span></a></div></section>
<section aria-labelledby="CreativeWorkHeading"><h2 id="CreativeWorkHeading">@Language.Translate("CreativeWorkHeading")</h2><div class="highlights"><article class="highlight-card"><h3>@Language.Translate("VideoProduction")</h3><p>@Language.Translate("VideoProductionText")</p></article><article class="highlight-card"><h3>@Language.Translate("DigitalProduction")</h3><p>@Language.Translate("DigitalProductionText")</p></article><article class="highlight-card"><h3>@Language.Translate("DesignProduction")</h3><p>@Language.Translate("DesignProductionText")</p></article></div></section>



<div class="hero-buttons"><a class="btn-secondary" href="https://www.behance.net/hakanberatdemircan" target="_blank" rel="noopener noreferrer">@Language.Translate("FullBehance")</a></div>

@code {
    protected override void OnInitialized() => Language.LanguageChanged += OnLanguageChanged;
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Language.LanguageChanged -= OnLanguageChanged;
}
