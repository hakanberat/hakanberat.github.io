>@Language.Translate("DiveHubSiteText")</p><span class="card-action">@Language.Translate("VisitChannel")</span></a></div></section><section class="contact-panel"><p class="section-kicker">@Language.Translate("ContactKicker")</p><h2>@Language.Translate("ContactPanelTitle")</h2><a class="contact-email" href="mailto:hakanberatdemircan@gmail.com">hakanberatdemircan@gmail.com</a><p>@Language.Translate("ContactPanelText")</p></section>
@code {
    protected override void OnInitialized() => Language.LanguageChanged += OnLanguageChanged;
