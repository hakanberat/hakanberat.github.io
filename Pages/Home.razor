@page "/"
@inject HakanBeratDemircan.Services.LanguageService Language
@implements IDisposable

<PageTitle>Hakan Berat Demircan | @Language.Translate("PortfolioPageTitle")</PageTitle>
<section class="hero portfolio-hero">
 <div class="hero-content">
  <p class="hero-label">@Language.Translate("HeroLabel")</p>
  <h1>Hakan Berat<br/><span>Demircan.</span></h1>
  <h2>@Language.Translate("DeveloperTitle")</h2>
  <p class="hero-description">@Language.Translate("HeroDescription")</p>
  <div class="hero-buttons"><a href="/projects" class="btn-primary">@Language.Translate("ViewSoftwareProjects")</a><a href="/contact" class="btn-secondary">@Language.Translate("ContactMe")</a></div>
  <div class="hero-socials"><a href="https://github.com/hakanberat" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/hakan-berat-demircan/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div>
 </div>
 <figure class="hero-visual">
  <img class="hero-sea" src="assets/underwater-hero.jpg" alt="@Language.Translate("HeroSeaAlt")" width="1536" height="1024" fetchpriority="high"/>
  <img class="hero-portrait" src="assets/hakan-portrait.jpg" alt="Hakan Berat Demircan" width="720" height="713"/>
  <figcaption class="hero-caption"><span>@Language.Translate("HeroImageCaption")</span><strong>@Language.Translate("HeroImageSub")</strong></figcaption>
 </figure>
</section>

<section class="expertise-section" aria-labelledby="expertise-title">
 <p class="section-kicker">@Language.Translate("ExpertiseKicker")</p><h2 id="expertise-title">@Language.Translate("ExpertiseTitle")</h2>
 <ul class="expertise-list">@foreach (var tech in new[] { "C#", ".NET 10", "ASP.NET Core", "Blazor", "SQL Server", ".NET MAUI" }) { <li>@tech</li> }</ul>
</section>
<section class="portfolio-section" aria-labelledby="featured-title">
 <div class="section-top"><div><p class="section-kicker">@Language.Translate("SoftwarePortfolioLabel")</p><h2 id="featured-title">@Language.Translate("FeaturedSoftware")</h2></div><a class="text-link" href="/projects">@Language.Translate("AllSoftware")</a></div>
 <div class="featured-software-grid">
 @foreach (var project in HakanBeratDemircan.Services.ProjectCatalog.All.Where(p => p.Featured).OrderBy(p => p.Name == "LifeDeck" ? 0 : p.Name.Contains("Management") ? 1 : 2)) { <ProjectCard Project="project" Compact="true" /> }
 </div>
</section>
<section class="background-section portfolio-section" aria-labelledby="background-title">
 <p class="section-kicker">@Language.Translate("MeetHakan")</p><h2 id="background-title">@Language.Translate("BackgroundTitle")</h2><p>@Language.Translate("AboutPortfolioText")</p>
 <div class="background-links"><a class="text-link" href="/experience">@Language.Translate("ViewExperience")</a><a class="text-link" href="/research">@Language.Translate("Research")</a><a class="text-link" href="/creative">@Language.Translate("Creative")</a><a class="text-link" href="/awards">@Language.Translate("Awards")</a></div>
</section>
<section class="contact-panel"><p class="section-kicker">@Language.Translate("ContactKicker")</p><h2>@Language.Translate("ContactPanelTitle")</h2><a class="contact-email" href="mailto:hakanberatdemircan@gmail.com">hakanberatdemircan@gmail.com</a><p>@Language.Translate("ContactPanelText")</p></section>
@code {
    protected override void OnInitialized() => Language.LanguageChanged += OnLanguageChanged;
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Language.LanguageChanged -= OnLanguageChanged;
}
