@page "/projects"
@using System.Linq
@using HakanBeratDemircan.Services
@inject HakanBeratDemircan.Services.LanguageService Language
@implements IDisposable

<PageTitle>@Language.Translate("Projects") | Hakan Berat Demircan</PageTitle>

<section class="software-projects">
    <header class="projects-hero">
        <p class="projects-eyebrow">@Language.Translate("SoftwarePortfolioLabel")</p>
        <div class="projects-title-row">
            <h1>@Language.Translate("Projects")</h1>
            <span class="projects-total" aria-label="@Language.Translate("TotalProjects")">@projects.Count</span>
        </div>
        <p class="projects-intro">@Language.Translate("ProjectsIntro")</p>
    </header>

    <div class="projects-toolbar">
        <div class="projects-search-wrapper">
            <label class="screen-reader-only" for="projects-search">
                @Language.Translate("SearchProjects")
            </label>
            <input id="projects-search"
                   class="projects-search"
                   type="search"
                   placeholder="@Language.Translate("SearchPlaceholder")"
                   @bind="searchTerm"
                   @bind:event="oninput" />
        </div>

        <div class="project-filters" role="group"
             aria-label="@Language.Translate("ProjectCategories")">
            @foreach (var category in categories)
            {
                <button type="button"
                        class="project-filter @(selectedCategory == category ? "selected" : "")"
                        aria-pressed="@(selectedCategory == category)"
                        @onclick="() => SelectCategory(category)">
                    @Language.Translate("Category_" + category)
                </button>
            }
        </div>
    </div>

    <p class="projects-results" aria-live="polite">
        @FilteredProjects.Count() @Language.Translate("ProjectResults")
    </p>

    @if (!FilteredProjects.Any())
    {
        <div class="projects-empty">
            <p>@Language.Translate("NoProjectsFound")</p>
            <button type="button" @onclick="ClearFilters">
                @Language.Translate("ClearFilters")
            </button>
        </div>
    }
    else
    {
        <div class="projects-grid">
            @foreach (var project in FilteredProjects)
            {
                <ProjectCard Project="project" />
            }
        </div>
    }
</section>

@code {
    private string searchTerm = string.Empty;
    private string selectedCategory = "all";

    private readonly string[] categories =
    {
        "all", "web", "pwa", "desktop", "mobile", "legacy"
    };

    private IReadOnlyList<PortfolioProject> projects => ProjectCatalog.All;
    private IEnumerable<PortfolioProject> FilteredProjects =>
        projects.Where(project =>
            (selectedCategory == "all" || project.Category == selectedCategory) &&
            (string.IsNullOrWhiteSpace(searchTerm) ||
             project.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             Language.Translate(project.DescriptionKey + "Problem")
                 .Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             Language.Translate(project.DescriptionKey)
                 .Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             project.Technologies.Any(technology =>
                 technology.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))));

    private void SelectCategory(string category) => selectedCategory = category;

    private void ClearFilters()
    {
        selectedCategory = "all";
        searchTerm = string.Empty;
    }

    protected override void OnInitialized()
    {
        Language.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Language.LanguageChanged -= OnLanguageChanged;

}
